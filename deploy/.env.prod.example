# Copy to deploy/.env and fill in. Used by docker-compose.prod.yml and mirrors
# the variables you set on Railway.

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_MASTER_KEY=REPLACE_32_BYTE_BASE64
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_RANDOM_SECRET

# Database passwords (compose creates the roles; on Railway use the provided URLs).
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app

# Public URLs (API_BASE_URL is baked into the web bundle at build time — split
# services only; the single-service topology calls the API same-origin).
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Single-service (APP=all) only ---
# The all-in-one container migrates on boot and creates the app role itself.
# (The internal API port is pinned to 4000 to match the web bundle's baked proxy.)
RUN_MIGRATIONS_ON_BOOT=true
CRMS_APP_ROLE=crms_app

# --- Optional integrations (activate features by adding credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICES={}
SANDBOX_RUNNER=off

# --- Object storage (S3-compatible) for files/documents/DSAR exports ---
S3_ENDPOINT=
S3_BUCKET=crms-platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
