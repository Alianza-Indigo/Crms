{
  "$schema": "https://railway.app/railway.schema.json",
  "//": "PRD §35.2 — API, workers, PostgreSQL, Redis run on Railway. Deploy each service from this repo with the APP build-arg; provision Postgres + Redis plugins and set the env vars from .env.example.",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "services": {
    "api": { "build": { "args": { "APP": "api" } }, "deploy": { "startCommand": "pnpm --filter @crms/api serve" } },
    "worker": { "build": { "args": { "APP": "worker" } }, "deploy": { "startCommand": "pnpm --filter @crms/worker serve", "healthcheckPath": null } }
  }
}
