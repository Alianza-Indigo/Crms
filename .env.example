# ============================================================================
# CRMS Platform — Environment configuration
# Copy to .env and fill in. NEVER commit .env. Secrets live in a secret manager
# in real deployments; this file only holds the platform's own bootstrap config.
# Tenant (BYO) credentials are NEVER stored here — they live encrypted in the DB.
# ============================================================================

NODE_ENV=development

# --- Core infrastructure (platform-owned) ---
# PostgreSQL — single shared DB for Tier 1 tenants. Tier 2/3 tenants get their
# own schema/cluster/database resolved at runtime via TenantRouting.
DATABASE_URL=postgres://crms:crms@localhost:5432/crms

# Redis — cache + BullMQ queues (segmented per tenant via key prefixes).
REDIS_URL=redis://localhost:6379

# --- Cryptography ---
# 32-byte master key (base64) used for envelope encryption of tenant secrets.
# In production this MUST come from a KMS/secret manager, not from disk.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Session / JWT signing secret for interactive auth.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- URLs ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
WEBHOOK_BASE_URL=http://localhost:4000/webhooks

# --- Ports ---
API_PORT=4000
WEB_PORT=3000
REALTIME_PORT=4001

# --- Object storage (S3-compatible, platform-owned bucket for platform assets) ---
# Tenants may attach their own BYO storage; this is only for platform-level files.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crms-platform
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Impersonation ---
# Max lifetime (seconds) of an admin/reseller impersonation session.
IMPERSONATION_MAX_TTL_SECONDS=1800
